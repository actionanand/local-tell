<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LocalTell.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/localtell_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.LocalTell</item>
    </style>

    <style name="Theme.LocalTell" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#09120D</item>
        <item name="android:navigationBarColor">#101A14</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
